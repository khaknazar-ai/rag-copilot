APP_NAME=Consular Services RAG Copilot
APP_ENV=local
API_HOST=127.0.0.1
API_PORT=8000

# Required by Docker Compose for its local PostgreSQL service.
POSTGRES_PASSWORD=

# Raw question logging is opt-in.
QUERY_LOG_ENABLED=false

QDRANT_MODE=local
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=rag_documents
QDRANT_LOCAL_PATH=data/qdrant_local

EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=hashing
EMBEDDING_DIM=384

LLM_PROVIDER=local
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_SECONDS=120

CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.25
LEXICAL_MIN_OVERLAP_TERMS=1

RERANKER_PROVIDER=none
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANKER_TOP_N=5
CACHE_PROVIDER=none
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_TTL_SECONDS=3600
METADATA_DB_PROVIDER=none
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag_metadata
POSTGRES_USER=rag_user
POSTGRES_CONNECT_TIMEOUT_SECONDS=3
